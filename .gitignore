# =============================
# 🛠️ Archivos y carpetas de Godot
# =============================

# --- No versionar archivos generados localmente por el editor ---
# La carpeta .godot contiene la caché y configuraciones locales del editor.
# ¡No se deben incluir en el repositorio!
.godot/

# --- Versionar archivos esenciales del proyecto ---
# Nota: Asegúrate de NO ignorar 'project.godot', ya que es la configuración global del proyecto.
!project.godot
# Y versiona tus escenas (por ejemplo, en la carpeta scenes/).

# Caché de recursos generados automáticamente por el editor
.import/

# Caché de exportación
.export/

# =============================
# 📄 Archivos temporales y logs
# =============================

# Archivos de usuario y temporales
*.tmp
*.log
*.bak
*.cfg
*.ini
*.mono

# Archivos de backup de scripts
*.gd~
*.tscn~
*.tres~
*.res~

# =============================
# 🎮 Archivos específicos de Godot
# =============================

# Traducciones y conversiones de assets
*.translation
*.remap
*.converted.*

# (La configuración de la interfaz del editor, que está dentro de .godot, ya se ignora)

# =============================
# 🖥️ Archivos de compilación (si usás C#)
# =============================

mono/
*.csproj
*.sln
*.mdb
*.pdb
*.dll
*.exe

# =============================
# 📝 Archivos del editor y configuraciones
# =============================

.editor_config
.settings/

# =============================
# 🌐 Git y otros archivos no deseados
# =============================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
~$*
.nfs*

# Archivos de control de versiones de otros sistemas
*.swp
*.swo
*.swn

# =============================
# 📦 Exportaciones y builds
# =============================

export/
releases/
*.exe
*.apk
*.pck
*.zip
*.7z
